# VirusTotal API key
# Получить: https://www.virustotal.com/gui/my-apikey
VT_API_KEY=your_virustotal_api_key_here

# Vulners API key
# Получить: https://vulners.com/userinfo (Settings → API Key)
VULNERS_API_KEY=your_vulners_api_key_here

# Telegram
# Токен бота — получить у @BotFather командой /newbot
TG_BOT_TOKEN=your_telegram_bot_token_here

# Chat ID — получить у @userinfobot или @getidsbot (можно группу: -100xxxxxxxxxx)
TG_CHAT_ID=your_chat_id_here